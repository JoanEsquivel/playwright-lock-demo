{
  "name": "playwright-sharding-lock-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Educational Playwright Test locks, workers, sharding, and authentication demo",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "playwright test",
    "test:setup": "playwright test --project=setup",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:auth": "playwright test tests/e2e/auth --project=e2e",
    "test:locking": "node scripts/clean-demo-output.mjs && playwright test tests/e2e/locking --project=e2e",
    "test:shard:1": "playwright test --shard=1/2",
    "test:shard:2": "playwright test --shard=2/2",
    "demo:locks": "node scripts/clean-demo-output.mjs && playwright test tests/locking --workers=4",
    "demo:cross-shard": "node scripts/cross-shard-lock-demo.mjs",
    "demo:clean": "node scripts/clean-demo-output.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "sync:agents": "node scripts/sync-agent-config.mjs",
    "sync:agents:check": "node scripts/sync-agent-config.mjs --check",
    "report": "playwright show-report",
    "report:merge": "playwright merge-reports --reporter html ./blob-report",
    "playwright-cli": "playwright-cli"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-playwright": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.5.4"
  }
}
