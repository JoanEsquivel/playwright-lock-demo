{
  "name": "playwright-sharding-lock-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Educational Playwright Test locks, workers, sharding, and authentication demo",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "playwright test",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:auth": "playwright test tests/auth",
    "test:locking": "node scripts/clean-demo-output.mjs && playwright test tests/locking",
    "test:shard:1": "playwright test --shard=1/2",
    "test:shard:2": "playwright test --shard=2/2",
    "demo:locks": "node scripts/clean-demo-output.mjs && playwright test tests/locking --workers=4",
    "demo:cross-shard": "node scripts/cross-shard-lock-demo.mjs",
    "demo:clean": "node scripts/clean-demo-output.mjs",
    "typecheck": "tsc --noEmit",
    "playwright-cli": "playwright-cli"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  }
}
