# ---- UI under test ----
BASE_URL=https://joanesquivel.github.io/the-test-automation-website/

# Customer seed account (used by the setup project and every "session reader" test)
E2E_USERNAME=
E2E_PASSWORD=

# Admin seed account (used by the "session writer" test that takes over the shared session)
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# ---- Optional ----
# BROWSERS=chromium,firefox,webkit   # extra browser projects: ui-firefox, e2e-webkit, ...
# WORKERS=1                          # force serial execution locally
